<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="app.olauncher.ui.HomeFragment"
        android:label="main_fragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_mainFragment_to_appListFragment"
            app:destination="@id/appListFragment"
            app:enterAnim="@anim/fade_enter"
            app:exitAnim="@anim/slide_out_top"
            app:popEnterAnim="@anim/slide_in_top"
            app:popExitAnim="@anim/fade_exit" />
        <action
            android:id="@+id/action_mainFragment_to_settingsFragment"
            app:destination="@id/settingsFragment"
            app:enterAnim="@anim/fade_enter"
            app:exitAnim="@anim/fade_exit"
            app:popEnterAnim="@anim/fade_enter"
            app:popExitAnim="@anim/fade_exit" />
    </fragment>

    <fragment
        android:id="@+id/appListFragment"
        android:name="app.olauncher.ui.AppDrawerFragment"
        android:label="app_list_fragment"
        tools:layout="@layout/fragment_app_drawer">
        <action
            android:id="@+id/action_appListFragment_to_settingsFragment2"
            app:destination="@id/settingsFragment"
            app:enterAnim="@anim/fade_enter"
            app:exitAnim="@anim/fade_exit"
            app:popEnterAnim="@anim/fade_enter"
            app:popExitAnim="@anim/fade_exit"
            app:popUpTo="@+id/appListFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="app.olauncher.ui.SettingsFragment"
        android:label="SettingsFragment"
        android:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settingsFragment_to_appListFragment"
            app:destination="@id/appListFragment"
            app:enterAnim="@anim/fade_enter"
            app:exitAnim="@anim/fade_exit"
            app:popEnterAnim="@anim/fade_enter"
            app:popExitAnim="@anim/fade_exit" />
    </fragment>

    <!-- Waypoint screens: reached from Settings (navigated by destination id) -->
    <fragment
        android:id="@+id/worldClockSettingsFragment"
        android:name="app.olauncher.features.worldclock.ui.WorldClockSettingsFragment"
        tools:layout="@layout/fragment_wp_page" />
    <fragment
        android:id="@+id/worldClockPanelFragment"
        android:name="app.olauncher.features.worldclock.ui.WorldClockPanelFragment"
        tools:layout="@layout/fragment_wp_page" />
    <fragment
        android:id="@+id/gestureSettingsFragment"
        android:name="app.olauncher.features.gestures.ui.GestureSettingsFragment"
        tools:layout="@layout/fragment_wp_page" />
    <fragment
        android:id="@+id/appearanceSettingsFragment"
        android:name="app.olauncher.features.appearance.ui.AppearanceSettingsFragment"
        tools:layout="@layout/fragment_wp_page" />
    <fragment
        android:id="@+id/notificationAccessFragment"
        android:name="app.olauncher.features.notifications.ui.NotificationAccessFragment"
        tools:layout="@layout/fragment_wp_page" />
    <fragment
        android:id="@+id/transactionLedgerFragment"
        android:name="app.olauncher.features.transactions.ui.TransactionLedgerFragment"
        tools:layout="@layout/fragment_wp_page" />
    <fragment
        android:id="@+id/exportPreviewFragment"
        android:name="app.olauncher.features.export.ui.ExportPreviewFragment"
        tools:layout="@layout/fragment_wp_page" />
    <fragment
        android:id="@+id/privacyDataFragment"
        android:name="app.olauncher.features.privacy.PrivacyDataFragment"
        tools:layout="@layout/fragment_wp_page" />
    <fragment
        android:id="@+id/graphFragment"
        android:name="app.olauncher.features.math.ui.GraphFragment" />
    <fragment
        android:id="@+id/assistantSettingsFragment"
        android:name="app.olauncher.features.assistant.ui.AssistantSettingsFragment"
        tools:layout="@layout/fragment_wp_page" />

</navigation>