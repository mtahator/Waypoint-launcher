<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The transaction ledger is excluded from cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="ledger.db" />
        <exclude domain="database" path="ledger.db-journal" />
        <exclude domain="database" path="ledger.db-wal" />
        <exclude domain="database" path="ledger.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="ledger.db" />
        <exclude domain="database" path="ledger.db-journal" />
        <exclude domain="database" path="ledger.db-wal" />
        <exclude domain="database" path="ledger.db-shm" />
    </device-transfer>
</data-extraction-rules>
