<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. The transaction ledger never leaves the device via backup. -->
<full-backup-content>
    <exclude domain="database" path="ledger.db" />
    <exclude domain="database" path="ledger.db-journal" />
    <exclude domain="database" path="ledger.db-wal" />
    <exclude domain="database" path="ledger.db-shm" />
        <exclude domain="database" path="chats.db" />
        <exclude domain="database" path="chats.db-journal" />
        <exclude domain="database" path="chats.db-wal" />
        <exclude domain="database" path="chats.db-shm" />
        <exclude domain="database" path="space.db" />
        <exclude domain="database" path="space.db-journal" />
        <exclude domain="file" path="space/" />
        <exclude domain="file" path="chat_images/" />
</full-backup-content>
