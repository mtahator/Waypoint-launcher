<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="?attr/primaryShadeDarkColor"
    android:orientation="vertical">

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="0.1" />

    <LinearLayout
        android:id="@+id/searchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="horizontal">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:gravity="start"
            android:imeOptions="actionSearch"
            android:paddingHorizontal="7dp"
            android:paddingVertical="0dp"
            app:closeIcon="@null"
            app:iconifiedByDefault="false"
            app:queryBackground="@null"
            app:queryHint="@string/wp_search_hint"
            app:searchIcon="@null"
            app:theme="@style/AppSearchText" />

        <TextView
            android:id="@+id/appRename"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="20dp"
            android:paddingVertical="@dimen/app_padding_vertical"
            android:text="@string/rename"
            android:textAllCaps="true"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Waypoint: Spotlight-style answer (calculator, % of, units, time in a city). Tap to copy. -->
    <LinearLayout
        android:id="@+id/quickAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/quickAnswerValue"
            style="@style/TextLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="44sp"
            android:textDirection="ltr" />

        <TextView
            android:id="@+id/quickAnswerDetail"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAllCaps="true" />
    </LinearLayout>

    <!-- Waypoint: "?" opens a full composer for a Gemini question (paragraphs welcome) -->
    <LinearLayout
        android:id="@+id/geminiComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/geminiTitle"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="12dp"
            android:text="@string/wp_ask_gemini"
            android:textAllCaps="true" />

        <EditText
            android:id="@+id/geminiInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/wp_composer_background"
            android:fontFamily="?attr/mainFontFamily"
            android:gravity="top|start"
            android:hint="@string/wp_gemini_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="10"
            android:minLines="5"
            android:padding="18dp"
            android:scrollbars="vertical"
            android:textColor="?attr/primaryColor"
            android:textColorHint="?attr/primaryColorTrans50"
            android:textCursorDrawable="@drawable/wp_cursor"
            android:textDirection="firstStrong"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/geminiCancel"
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/wp_cancel"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/geminiCount"
                style="@style/TextSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.5"
                android:gravity="center"
                android:textDirection="ltr" />

            <TextView
                android:id="@+id/geminiSend"
                style="@style/TextMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/wp_send_background"
                android:paddingHorizontal="22dp"
                android:paddingVertical="10dp"
                android:text="@string/wp_send_to_gemini"
                android:textAllCaps="true"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.06" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="24dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fadingEdgeLength="24dp"
        android:requiresFadingEdge="vertical" />

</LinearLayout>